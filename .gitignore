# dependencies — unanchored so it also covers each workspace's own packages/*/node_modules,
# which npm creates whenever a package needs a version the root tree can't hoist
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# strava sync local token (rotated refresh token)
/.strava-token.json

# rolling stats — now live in the runtime store (Redis), not git. Local copies are a dev-only
# seed (run `npm run totals:refresh`); never committed.
/data/adventures/all-activities.json
/data/adventures/lifetime-totals.json
/data/adventures/yearly-totals.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
.cache/
.turbo/

# Local agent worktrees
/worktrees/
/.claude/worktrees/

# Python virtual environment
.venv/
venv/
env/

# Kiro
.kiro/

# Generated/temporary files
inspect_notebook.html
screenshot-truncated-table.png

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Data files (if you don't want to commit them)
# content/projects/data/

# strava history triage output (local only)
/.strava-sweep.json

# deprecated one-time Strava bootstrapping tooling — kept locally, out of version control
/scripts/strava-sweep.ts
/scripts/strava-inbox.ts
/scripts/strava-bootstrap.ts

# local scratch (screenshots, review docs)
/.tmp-screens/
