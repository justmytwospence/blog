{
  "directories": {
    "read": ["*"],
    "write": []
  },
  "permissions": {
    "allow": [
      "Bash(npm run preview:push)",
      "Bash(npm run preview:push --)"
    ],
    "ask": [
      "Bash(*vercel*--prod*)",
      "Bash(*vercel*--target*production*)",
      "Bash(*vercel* promote*)",
      "Bash(*vercel* rollback*)",
      "Bash(*vercel* alias*)",
      "Bash(*vercel* redeploy*)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(*vercel* env*)",
      "Bash(*vercel* project*)",
      "Bash(*vercel* domains*)",
      "Bash(*vercel* api*)",
      "mcp__vercel"
    ]
  }
}
